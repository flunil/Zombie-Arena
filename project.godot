; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zombie Arena 3D"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=1000

[autoload]

GameManager="*res://scripts/systems/game_manager.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[editor_plugins]

enabled=PackedStringArray("res://addons/constructive_telegraphs/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[input]

move_left={
"deadzone": 0.5,
