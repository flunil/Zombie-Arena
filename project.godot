[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="enemy"
3d_physics/layer_3="player"
3d_physics/layer_4="bullet"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=1
scaling_3d/scale=0.7
shadows/quality/directional_shadow_atlas_size=1024
shadows/quality/soft_shadow_filter_quality=0

[shader_globals]

diffuse_curve={
"type": "sampler2D",
"value": "res://shaders/cel/diffuse-texture.tres"
}
fresnel_smoothness={
"type": "float",
"value": 0.05
}
specular_smoothness={
"type": "float",
"value": 0.05
}
outline_width={
"type": "float",
"value": 6.0
}
outline_color={
"type": "color",
"value": {
"a": 1.0,
"b": 0.0,
"g": 0.0,
"r": 0.0
}
}
